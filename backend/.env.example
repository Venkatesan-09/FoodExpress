# Environment Variables — FoodExpress Backend
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI="mongodb+srv://vp2064670_db_user:8yuDotsk6pqjAc7T@cluster.mongodb.net/foodexpress?retryWrites=true&w=majority"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_min_64_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# In development: http://localhost:5173
# In production: your Vercel frontend URL (e.g. https://foodexpress.vercel.app)
CLIENT_URL=http://localhost:5173

# ─── Cloudinary (Image Uploads) ───────────────────────────────────────────────
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME="FoodExpress"
CLOUDINARY_API_KEY="495744197484217"
CLOUDINARY_API_SECRET="kEs6oRzpCXOHB7JE77ZGN4XtFvw"

# ─── Mock Map / Demo ──────────────────────────────────────────────────────────
# Default map center for demo (Bengaluru, India)
DEMO_MAP_CENTER_LAT=12.9716
DEMO_MAP_CENTER_LNG=77.5946

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
